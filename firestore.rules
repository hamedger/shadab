rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminEmail() {
      return request.auth != null && request.auth.token.email in [
        'deccanbawarchi7@gmail.com',
      ];
    }
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || isAdminEmail()
      );
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function protectedUserFields() {
      return ['loyaltyPoints', 'loyaltyTier', 'totalOrderCount', 'totalSpend', 'createdAt'];
    }

    function clientSafeUserCreate(userId) {
      let data = request.resource.data;
      return data.uid == userId
        && data.keys().hasAll(['uid', 'email', 'displayName'])
        && !data.keys().hasAny(protectedUserFields());
    }

    function clientSafeUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedUserFields());
    }

    function clientSafeProfilePatch(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(protectedUserFields());
    }

    // Users — profile fields client-writable; loyalty & stats server-only
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && clientSafeUserCreate(userId));
      allow update: if isAdmin() || (isOwner(userId) && (clientSafeUserUpdate() || clientSafeProfilePatch(userId)));
      allow delete: if isAdmin();
    }

    // Menu — public read, admin write
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Buffet — public read, admin write
    match /buffet/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — authenticated create/read own, admin manage; loyalty fields server-only on update
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.loyaltyAwarded == false;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    // Reviews — public read, authenticated create (1 per orderItem)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Promos — public read, admin write
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reservations — prepaid ones are created server-side (Clover checkout; admin SDK bypasses
    // these rules). While prepayment is off, the website books pay-at-restaurant reservations
    // directly; only that exact shape, for the signed-in user, already confirmed, is allowed.
    match /reservations/{reservationId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'name', 'email', 'phone', 'partySize', 'meal', 'adults', 'children',
          'infants', 'date', 'time', 'startsAtMs', 'capacityBlockId', 'occasion', 'specialRequests',
          'locationId', 'status', 'paymentMethod', 'subtotalCents', 'taxCents', 'estimatedTotalCents',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'userId', 'name', 'phone', 'partySize', 'meal', 'adults', 'children',
          'infants', 'date', 'time', 'startsAtMs', 'capacityBlockId', 'locationId', 'status',
          'paymentMethod', 'subtotalCents', 'taxCents', 'estimatedTotalCents', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == reservationId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.paymentMethod == 'pay_at_restaurant'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 200
            && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')))
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 30
        && request.resource.data.meal in ['dinner']
        && request.resource.data.adults is int && request.resource.data.adults >= 1
        && request.resource.data.children is int && request.resource.data.children >= 0
        && request.resource.data.infants is int && request.resource.data.infants >= 0
        && request.resource.data.partySize == request.resource.data.adults
          + request.resource.data.children + request.resource.data.infants
        && request.resource.data.partySize <= 40
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^[0-9]{1,2}:[0-9]{2} (AM|PM)$')
        && request.resource.data.startsAtMs is int
        && request.resource.data.startsAtMs > request.time.toMillis()
        && request.resource.data.startsAtMs < request.time.toMillis() + 32 * 24 * 60 * 60 * 1000
        // The party must be added to its 90-minute block's guest counter in the same write.
        && request.resource.data.capacityBlockId is string
        && request.resource.data.capacityBlockId.matches(request.resource.data.date + '_dinner_[0-9]+')
        && getAfter(/databases/$(database)/documents/reservationCapacity/$(request.resource.data.capacityBlockId))
          .data.lastReservationId == reservationId
        && request.resource.data.get('occasion', '') is string
        && request.resource.data.get('occasion', '').size() <= 100
        && request.resource.data.get('specialRequests', '') is string
        && request.resource.data.get('specialRequests', '').size() <= 1000
        && request.resource.data.locationId is string
        && request.resource.data.locationId.size() > 0 && request.resource.data.locationId.size() <= 64
        && request.resource.data.subtotalCents is int && request.resource.data.subtotalCents >= 0
        && request.resource.data.taxCents is int && request.resource.data.taxCents >= 0
        && request.resource.data.estimatedTotalCents == request.resource.data.subtotalCents
          + request.resource.data.taxCents
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      // Status, payment, and refund fields are server/admin-only.
      allow update: if isAdmin();
    }

    // Guests booked per 90-minute seating block ({date}_{meal}_{block}); public so the site can
    // grey out full times. Customers may only add a new reservation's party, up to 100 guests;
    // admins adjust it when cancelling or restoring a booking.
    match /reservationCapacity/{blockId} {
      function addedReservation() {
        return getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.lastReservationId)).data;
      }
      allow read: if true;
      allow write: if isAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['guests', 'lastReservationId'])
        && request.resource.data.lastReservationId is string
        && !exists(/databases/$(database)/documents/reservations/$(request.resource.data.lastReservationId))
        && addedReservation().capacityBlockId == blockId
        && request.resource.data.guests is int
        && request.resource.data.guests <= 100
        && request.resource.data.guests == (resource == null ? 0 : resource.data.guests) + addedReservation().partySize;
    }

    // Catering inquiries — public create with required fields, admin read
    match /catering_inquiries/{docId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'eventDate', 'headcount', 'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.headcount is int
        && request.resource.data.headcount >= 10
        && request.resource.data.status == 'pending';
      allow read, update: if isAdmin();
    }

    // Locations — public read, admin write
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI growth insights — admin read only, Cloud Functions write
    match /admin_insights/{locationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
